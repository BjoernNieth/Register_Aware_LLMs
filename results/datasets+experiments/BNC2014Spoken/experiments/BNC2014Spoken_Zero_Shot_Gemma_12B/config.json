{
    "dataset": "Biber_Study_Dataset",
    "experiment_name": "BNC2014Spoken_Zero_Shot_Gemma_12B",
    "model": {
        "name": "google/gemma-3-12b-it",
        "model_args": {
            "gpu_memory_utilization": 0.96,
            "max_num_seqs": 204,
            "tensor_parallel_size": 2,
            "max_model_len": 1600
        }
    },
    "prompts": {
        "prompt_type": "Chat",
        "system_prompt": {
            "role": "system",
            "content": "Your task is to write a multi-speaker conversation based on the provided context information about the speakers and situation. The conversation should be at least 400 words long. It may begin in the middle of an interaction. Label turns as 'Speaker_1:', 'Speaker_2:', and so on."
        },
        "iterative_prompts": [
            {
                "user_prompt": {
                    "role": "user",
                    "content": "Generate a conversation using the following information: {Speaker_Metadata}\n{Conversation_Context}"
                },
                "assistant_prompt_start": {
                    "role": "assistant",
                    "content": "Sure, here is my answer: "
                },
                "assistant_prompt_few_shot": {
                    "role": "assistant",
                    "content": "Sure, here is my answer: {Conversation}"
                },
                "parse_output": true,
                "output_name": "generated_text",
                "prompt_args": {
                    "min_tokens": 800,
                    "max_tokens": 900,
                    "temperature": 1.0,
                    "top_p": 1,
                    "ignore_eos": true,
                    "stop": null
                }
            }
        ]
    },
    "n-shot": 0,
    "seed": 271
}