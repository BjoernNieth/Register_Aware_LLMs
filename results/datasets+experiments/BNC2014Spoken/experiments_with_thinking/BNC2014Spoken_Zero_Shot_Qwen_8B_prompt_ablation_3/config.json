{
    "dataset": "Biber_Study_Dataset",
    "experiment_name": "BNC2014Spoken_Zero_Shot_Qwen_8B_prompt_ablation_3",
    "model": {
        "name": "Qwen/Qwen3-8B",
        "model_args": {
            "gpu_memory_utilization": 0.96,
            "max_num_seqs": 300,
            "tensor_parallel_size": 2,
            "max_model_len": 1700
        }
    },
    "prompts": {
        "prompt_type": "Chat",
        "system_prompt": {
            "role": "system",
            "content": "Please create a detailed conversation of at least 400 words that faithfully reflects the provided speaker characteristics and situational context. The conversation may begin mid-discussion. Use 'Speaker_1:' and similar labels."
        },
        "iterative_prompts": [
            {
                "user_prompt": {
                    "role": "user",
                    "content": "Use the following metadata to write the conversation: {Speaker_Metadata}\n {Conversation_Context}"
                },
                "assistant_prompt_start": {
                    "role": "assistant",
                    "content": "Sure, here is my answer: "
                },
                "assistant_prompt_few_shot": {
                    "role": "assistant",
                    "content": "Sure, here is my answer: "
                },
                "parse_output": true,
                "output_name": "generated_text",
                "prompt_args": {
                    "min_tokens": 900,
                    "max_tokens": 1000,
                    "temperature": 1.0,
                    "top_p": 1,
                    "ignore_eos": true,
                    "stop": null
                }
            }
        ]
    },
    "n-shot": 0,
    "seed": 271
}