[
  {
    "dataset": "Biber_Study_Dataset",
    "experiment_name": "BNC2014Spoken_Zero_Shot_Llama_8B_prompt_ablation_2",
    "model": {
      "name": "meta-llama/Llama-3.1-8B-Instruct",
      "model_args": {
        "gpu_memory_utilization": 0.96,
        "max_num_seqs": 300,
        "tensor_parallel_size": 2,
        "max_model_len": 1750
      }
    },
    "prompts": {
      "prompt_type": "Chat",
      "system_prompt": {
        "role": "system",
        "content": "Your goal is to write a multi-speaker conversation. Use the speaker information and context provided by the user. You can jump right into an ongoing exchange. Make sure it's at least 400 words and mark each turn with 'Speaker_1:', 'Speaker_2:', etc."
      },
      "iterative_prompts": [
        {
          "user_prompt": {
            "role": "user",
            "content": "Here's the background info. Please write the conversation: {Speaker_Metadata}\n{Conversation_Context}"
          },
          "assistant_prompt_start": {
            "role": "assistant",
            "content": "Certainly, here is my answer: "
          },
          "assistant_prompt_few_shot": {
            "role": "assistant",
            "content": "Certainly, here is my answer: {Conversation}"
          },
          "parse_output": true,
          "output_name": "generated_text",
          "prompt_args": {
            "min_tokens": 950,
            "max_tokens": 1050,
            "temperature": 1.0,
            "top_p": 1,
            "ignore_eos": true,
            "stop": null
          }
        }
      ]
    },
    "n-shot": 0,
    "seed": 271
  }
]