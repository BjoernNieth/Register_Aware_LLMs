[
  {
    "dataset": "Biber_Study_Dataset",
    "experiment_name": "S2ORC_ACL_Zero_Shot_Llama_8B_DeepSeek_R1_Llama_8B",
    "model": {
      "name": "deepseek-ai/DeepSeek-R1-Distill-Llama-8B",
      "model_args": {
        "gpu_memory_utilization": 0.96,
        "max_num_seqs": 300,
        "tensor_parallel_size" : 2,
        "max_model_len": 1050
      }
    },
    "prompts": {
        "prompt_type": "Chat",
        "system_prompt": {
            "role": "system",
            "content": "You are an author of an ACL paper. Your task is to write the introduction of the paper given its abstract and title. Write an introduction of at least 400 words. Please output only the introduction text."
        },
        "iterative_prompts": [
            {
                "user_prompt": {
                    "role": "user",
                    "content": "Please write a paper given the following title and abstract: {title}\n{abstract}"
                }, 
                "assistant_prompt_start": {
                    "role": "assistant",
                    "content": "Certainly, here is my answer: "
                },
                "assistant_prompt_few_shot": {
                    "role": "assistant", "content": "Certainly, here is my answer: {introduction}"
                },
                "parse_output": true,
                "output_name": "generated_text",
                "prompt_args": {
                    "min_tokens": 600,
                    "max_tokens": 700,
                    "temperature": 1.0,
                    "top_p": 1,
                    "ignore_eos": true,
                    "stop": null
                }
            }
        ]
    },
    "n-shot": 0,
    "seed": 271
}
]