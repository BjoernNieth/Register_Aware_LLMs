[
  {
    "dataset": "Biber_Study_Dataset",
    "experiment_name": "wikiHow_Zero_Shot_Qwen_8B",
    "model": {
      "name": "Qwen/Qwen3-8B",
      "model_args": {
        "gpu_memory_utilization": 0.96,
        "max_num_seqs": 300,
        "tensor_parallel_size" : 2,
        "max_model_len": 1100
      }
    },
    "prompts": {
        "prompt_type": "Chat",
        "system_prompt": {
            "role": "system",
            "content": "You are the author of a wikiHow article. Your task is to write the full article given the title and headline. Write an article of at least 400 words. Please only output the article text."
        },
        "iterative_prompts": [
            {
                "user_prompt": {
                    "role": "user",
                    "content": "Please write an article given the following title and headline: {title}\n{headline} /no_think"
                }, 
                "assistant_prompt_start": {
                    "role": "assistant",
                    "content": "Certainly, here is my answer: {title} "
                },
                "assistant_prompt_few_shot": {
                    "role": "assistant", "content": "Certainly, here is my answer: {text}"
                },
                "parse_output": true,
                "output_name": "generated_text",
                "prompt_args": {
                    "min_tokens": 700,
                    "max_tokens": 800,
                    "temperature": 1.0,
                    "top_p": 1,
                    "ignore_eos": true,
                    "stop": null
                }
            }
        ]
    },
    "n-shot": 0,
    "seed": 271
}
]